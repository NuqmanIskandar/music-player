# Copy to .env and fill in:  cp .env.example .env
# Address of the backend API, without a trailing slash. Baked into the build at
# `npm run build` time (it is public, not a secret).
#   - Leave empty when the frontend is served from the same address as the backend,
#     and in local dev (Vite forwards /api to http://127.0.0.1:8000).
#   - Otherwise e.g. https://music.example.com or http://203.0.113.10:8000
VITE_API_URL=
