# Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored. Never commit it.

# --- Auth ---
# Signs login tokens. Generate a new one per server:  openssl rand -hex 32
SECRET_KEY=change-me-run-openssl-rand-hex-32
# How long a login lasts before you must sign in again.
ACCESS_TOKEN_EXPIRE_DAYS=30
# Set to false after creating your account(s) so strangers can't sign up.
ALLOW_SIGNUP=true

# --- Web ---
# Comma-separated frontend origins allowed to call this API (scheme + host + port, no trailing slash).
# Not needed when the frontend is served by this same server (FRONTEND_DIST below).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: a regex for origins that change, like Vercel preview URLs. Example for a
# Vercel project named "music-player" (production + previews):
#   CORS_ORIGIN_REGEX=https://music-player(-[a-z0-9-]+)?\.vercel\.app
CORS_ORIGIN_REGEX=
# Optional: absolute path to the built frontend (frontend/dist) to serve it from this server.
FRONTEND_DIST=

# --- Storage & downloads ---
# Where MP3s, covers and the database live. Default: backend/storage
# STORAGE_DIR=/var/lib/music-player
MP3_QUALITY=192
MAX_CONCURRENT_DOWNLOADS=2

# Optional, if YouTube blocks the VPS ("Sign in to confirm you're not a bot"):
# a cookies.txt exported from a browser logged in to YouTube, and/or a proxy.
YTDLP_COOKIES_FILE=
YTDLP_PROXY=
